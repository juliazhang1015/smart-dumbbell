// ECE198 bench prototype. Arduino Nano ESP32, default Arduino pin numbering.
// One sketch, two builds: USE_BLE 0 = Wi-Fi AP + HTTP only, USE_BLE 1 = also a BLE notify characteristic.
// The curl/idle/other classifier (firmware/classifier, trained on data/sessions) runs on the board once
// per second in shadow mode: its label is shown, logged and sent, but does not gate the rep counter.
#define USE_BLE 1
#include <Wire.h>
#include <WiFi.h>
#include <WebServer.h>
#include <Adafruit_LSM6DSOX.h>
#include <Adafruit_SSD1306.h>
#include <MAX30105.h>
#include <heartRate.h>
#include "classifier.h"     // clf_features / clf_infer; model_weights.h is generated by ml/train/train.py
#include "selftest.h"       // one recorded window with the Python reference values, checked at boot
#if USE_BLE
#include <BLEDevice.h>
#include <BLE2902.h>
#endif

Adafruit_LSM6DSOX imu;
// 400 kHz during and after display(): the library default clkAfter=100000 would leave the shared
// bus at 100 kHz for the IMU and MAX30102 after every refresh (measured on this board, 2026-11-06).
Adafruit_SSD1306 oled(128,64,&Wire,-1,400000UL,400000UL);
MAX30105 ppg;
WebServer server(80);
enum State { READY, RUNNING, PAUSED, DONE };
State state=READY;
const char* names[]={"Ready","Running","Paused","Done"};
bool hasImu,hasPpg,hasOled;
unsigned reps=0, bpm=0;
unsigned long activeMs=0, started=0, lastBeat=0, beepAt=0, session=0;
unsigned long phaseAt=0, signalSince=0;
bool lifting=false, contact=false;
float firstSign=0;
// Heart rate: mean of the last BEAT_AVG valid beat intervals, shown once two are available.
const uint8_t BEAT_AVG=4;
uint16_t beatRates[BEAT_AVG]; uint8_t beatN=0, beatI=0;
// Rep gate: a counted rep must swing at least SWING_MIN_DEG about the handle axis and come back
// to within RETURN_FRAC of that swing.
// SWING_MIN_DEG is CALIBRATED PER USER: about 0.7 x that person's full-range swing. Have the user do
// ten full curls, read the SWING,... lines on the serial port, take the median and multiply by 0.7.
// Replayed on data/sessions (README): 80 deg for P01 and 105 deg for P02 keep every complete curl,
// reject the half curls (10/11 and 8/8) and leave 2 and 0 false reps in two minutes of other movement.
// 60 deg is the uncalibrated fallback: complete curls are counted but half curls are too.
const float SWING_MIN_DEG=60.0f, RETURN_FRAC=0.5f;
const unsigned long LIFT_TIMEOUT_MS=8000;   // slowest rehab-pace rep seen so far is 5.0 s
unsigned long elapsed(){return activeMs+(state==RUNNING ? millis()-started : 0);}

// IMU sampling at the classifier's rate, ring buffer and shadow inference.
const uint32_t IMU_PERIOD_US=1000000UL/CLF_FS;
uint32_t imuNext=0, imuLate=0;
static float ring[CLF_WINDOW][6], window[CLF_WINDOW][6], feats[CLF_N_FEATURES];
int ringHead=0, ringCount=0, sinceInfer=0;
int lastLabel=-1; float lastConf=0; uint32_t lastInferUs=0;
const char* labelName(){ return lastLabel<0 ? "--" : CLF_CLASSES[lastLabel]; }

#if USE_BLE
// Little-endian packet: version, state, session (4), active ms (4),
// reps (4), estimated BPM (2; zero means unavailable), classifier label (1; 255 = none yet).
const char* serviceId="823ef401-1d82-41f6-b689-68aedcbb1960";
const char* sampleId="823ef402-1d82-41f6-b689-68aedcbb1960";
BLEServer* bleServer;
BLECharacteristic* bleSample;
class ConnectionEvents : public BLEServerCallbacks {
  void onDisconnect(BLEServer* server) override { server->startAdvertising(); }
};
void beginBluetooth(){
  BLEDevice::init("SmartDumbbell");
  bleServer=BLEDevice::createServer();
  static ConnectionEvents events;
  bleServer->setCallbacks(&events);
  BLEService* service=bleServer->createService(serviceId);
  bleSample=service->createCharacteristic(sampleId,
    BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);
  bleSample->addDescriptor(new BLE2902());
  uint8_t initial[17]={1}; initial[16]=255;
  bleSample->setValue(initial,sizeof(initial));
  service->start();
  BLEAdvertising* advertising=BLEDevice::getAdvertising();
  advertising->addServiceUUID(serviceId);
  advertising->setScanResponse(true);
  advertising->start();
}
void publishBluetooth(){
  uint8_t packet[17]={1,static_cast<uint8_t>(state)};
  uint32_t ses=session, active=elapsed(), count=reps; uint16_t rate=bpm;
  memcpy(packet+2,&ses,4);
  memcpy(packet+6,&active,4);
  memcpy(packet+10,&count,4);
  memcpy(packet+14,&rate,2);
  packet[16]= lastLabel<0 ? 255 : static_cast<uint8_t>(lastLabel);
  bleSample->setValue(packet,sizeof(packet));
  if(bleServer->getConnectedCount()) bleSample->notify();
}
#endif

void feedback(){
  digitalWrite(D5,HIGH); beepAt=millis();
}
void resetPulse(){ contact=false; bpm=0; lastBeat=0; beatN=0; }
void changeState(bool hold){
  if(hold && state!=RUNNING && state!=PAUSED) return;
  if(state==RUNNING) activeMs+=millis()-started;
  if(hold) state=DONE;
  else if(state==RUNNING) state=PAUSED;
  else {
    if(state!=PAUSED){ activeMs=0; reps=0; session++; }
    state=RUNNING; started=millis();
  }
  lifting=false; resetPulse();
  digitalWrite(D7,state==RUNNING);
  feedback();
}
void button(){
  static bool raw=false, stable=false, consumed=false;
  static unsigned long changed=0, pressed=0;
  bool down=digitalRead(D2)==LOW;
  unsigned long now=millis();
  if(raw!=down){raw=down;changed=now;}
  if(raw!=stable && now-changed>=30){
    stable=raw;
    if(stable){pressed=changed;consumed=false;}
    else if(!consumed) changeState(changed-pressed>=1200);
  }
  if(raw && stable && !consumed && now-pressed>=1200){
    consumed=true; changeState(true);
  }
}
void samplePulse(){
  if(!hasPpg)return;
  ppg.check();
  while(ppg.available()){
    long ir=ppg.getFIFOIR(); ppg.nextSample();
    bool beat=checkForBeat(ir);
    unsigned long now=millis();
    if(state!=RUNNING || ir<50000){ resetPulse(); continue; }
    if(!contact){contact=true;signalSince=now;}
    if(beat && now-signalSince>=1500){
      unsigned long interval=now-lastBeat;
      if(lastBeat && interval>=300 && interval<=1500){
        beatRates[beatI]=60000/interval; beatI=(beatI+1)%BEAT_AVG; if(beatN<BEAT_AVG)beatN++;
        unsigned sum=0; for(uint8_t i=0;i<beatN;i++)sum+=beatRates[i];
        bpm = beatN>=2 ? sum/beatN : 0;
      }
      lastBeat=now;
    }
    if(now-lastBeat>2000){bpm=0;beatN=0;}
  }
}
// Bench baseline: mount the gyro X axis along the elbow rotation axis.
// A rep = one stroke, the opposite stroke, then low angular speed, with the swing gate above.
// speed in rad/s, dt in s, now in ms. Only called while RUNNING.
void counterSample(float speed, float dt, unsigned long now){
  static bool returning=false;
  static float swing=0, peak=0;          // integrated angle (rad) since the lift started, lift direction positive
  if(lifting){
    swing+=speed*dt*firstSign; if(swing>peak)peak=swing;
    if(now-phaseAt>LIFT_TIMEOUT_MS){lifting=false;Serial.printf("SWING,%lu,%.0f,timeout\n",now,peak*RAD_TO_DEG);return;}
  }
  if(!lifting){
    if(fabs(speed)>0.9){
      lifting=true; returning=false; phaseAt=now; firstSign=speed>0?1:-1;
      swing=fabs(speed)*dt; peak=swing;
    }
  }else if(!returning){
    if(now-phaseAt>200 && speed*firstSign< -0.9) returning=true;
  }else if(fabs(speed)<0.35 && now-phaseAt>450){
    if(peak<SWING_MIN_DEG*DEG_TO_RAD){ lifting=false; Serial.printf("SWING,%lu,%.0f,small\n",now,peak*RAD_TO_DEG); }   // not a rep
    else if(swing<=RETURN_FRAC*peak){ reps++; lifting=false; feedback(); Serial.printf("SWING,%lu,%.0f,rep=%u\n",now,peak*RAD_TO_DEG,reps); }
    // else: settled while still raised (overshoot bounce or incomplete lowering) -> wait for the real return
  }
}
void serviceIMU(){
  if(!hasImu || (int32_t)(micros()-imuNext)<0) return;
  imuNext+=IMU_PERIOD_US;
  if((int32_t)(micros()-imuNext)>0) imuLate++;
  sensors_event_t a,g,t;
  if(!imu.getEvent(&a,&g,&t)) return;
  unsigned long now=millis();
  float* s=ring[ringHead];
  s[0]=a.acceleration.x; s[1]=a.acceleration.y; s[2]=a.acceleration.z;
  s[3]=g.gyro.x*RAD_TO_DEG; s[4]=g.gyro.y*RAD_TO_DEG; s[5]=g.gyro.z*RAD_TO_DEG;   // classifier units: m/s^2, deg/s
  ringHead=(ringHead+1)%CLF_WINDOW; if(ringCount<CLF_WINDOW) ringCount++;
  if(state==RUNNING) counterSample(g.gyro.x, 1.0f/CLF_FS, now);
  if(ringCount==CLF_WINDOW && ++sinceInfer>=CLF_HOP){
    sinceInfer=0;
    for(int i=0;i<CLF_WINDOW;i++){ const float* src=ring[(ringHead+i)%CLF_WINDOW]; for(int c=0;c<6;c++) window[i][c]=src[c]; }
    uint32_t t0=micros();
    clf_features(window,feats);
    ClfResult r=clf_infer(feats);
    lastInferUs=micros()-t0; lastLabel=r.label; lastConf=r.conf;
    Serial.printf("C,%lu,%s,%.2f,%lu\n",now,CLF_CLASSES[r.label],r.conf,(unsigned long)lastInferUs);
  }
}
bool selfTest(){
  uint32_t t0=micros();
  clf_features(SELFTEST_RAW,feats);
  ClfResult r=clf_infer(feats);
  uint32_t dt=micros()-t0;
  float maxFeat=0, maxProb=0;
  for(int i=0;i<CLF_N_FEATURES;i++){ float sc=fabsf(SELFTEST_FEATURES[i])>1?fabsf(SELFTEST_FEATURES[i]):1; float e=fabsf(feats[i]-SELFTEST_FEATURES[i])/sc; if(e>maxFeat)maxFeat=e; }
  for(int j=0;j<CLF_N_CLASSES;j++){ float e=fabsf(r.probs[j]-SELFTEST_PROBS[j]); if(e>maxProb)maxProb=e; }
  bool ok=maxFeat<1e-3f && maxProb<1e-3f;
  Serial.printf("SELFTEST,%s,label=%s,conf=%.3f,max_feat_rel_err=%.2e,max_prob_err=%.2e,features+inference_us=%lu\n",
                ok?"PASS":"FAIL",CLF_CLASSES[r.label],r.conf,maxFeat,maxProb,(unsigned long)dt);
  return ok;
}
String row(){
  return String(session)+","+names[state]+","+String(elapsed())+","+String(reps)+","+(bpm?String(bpm):String(""))+","+labelName();
}
const char page[] PROGMEM=R"HTML(<!doctype html><meta charset=utf-8><title>Smart dumbbell</title>
<h1>Smart dumbbell</h1><p>Session, state, active milliseconds, reps, estimated BPM, classifier label</p>
<pre id="live">Connecting...</pre><button id="save">Download CSV</button>
<script>const rows=["session,state,active_ms,reps,bpm,label"];
async function poll(){try{const r=await fetch('/sample',{cache:'no-store'});if(!r.ok)throw Error();
const s=await r.text();live.textContent=s;if(rows[rows.length-1]!==s)rows.push(s)}
catch(e){live.textContent='Disconnected'}setTimeout(poll,500)}
save.onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([rows.join('\n')],{type:'text/csv'}));a.download='dumbbell.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};poll()</script>)HTML";
void setup(){
  Serial.begin(115200);
  pinMode(D2,INPUT_PULLUP);pinMode(D5,OUTPUT);pinMode(D7,OUTPUT);
  Wire.begin();Wire.setClock(400000);
  hasImu=imu.begin_I2C(0x6A,&Wire);
  if(hasImu){   // same settings as the recordings the classifier was trained on (ml/data-protocol.md)
    imu.setAccelRange(LSM6DS_ACCEL_RANGE_4_G); imu.setGyroRange(LSM6DS_GYRO_RANGE_500_DPS);
    imu.setAccelDataRate(LSM6DS_RATE_104_HZ);  imu.setGyroDataRate(LSM6DS_RATE_104_HZ);
  }
  hasPpg=ppg.begin(Wire,I2C_SPEED_FAST);
  if(hasPpg)ppg.setup(0x1F,4,2,400,411,4096); // 100 FIFO samples/s
  Wire.beginTransmission(0x3C);
  hasOled=Wire.endTransmission()==0 && oled.begin(SSD1306_SWITCHCAPVCC,0x3C,false,false);
  Serial.printf("IMU=%d MAX30102=%d OLED=%d\n",hasImu,hasPpg,hasOled);
  Serial.printf("classifier: %d features, %d layers, window %d, hop %d\n",CLF_N_FEATURES,CLF_N_LAYERS,CLF_WINDOW,CLF_HOP);
  selfTest();
  WiFi.softAP("SmartDumbbell","curl198demo");
  Serial.println(WiFi.softAPIP());
  server.on("/",[](){server.send_P(200,"text/html",page);});
  server.on("/sample",[](){server.send(200,"text/plain",row());});
  server.begin();
#if USE_BLE
  beginBluetooth();
#endif
  imuNext=micros();
}
void loop(){
  if (Serial.available() && Serial.read() == '?') {
    Serial.printf("IMU=%d MAX30102=%d OLED=%d imu_late=%lu\n", hasImu, hasPpg, hasOled, (unsigned long)imuLate);
    Serial.print("I2C addresses:");
    for (uint8_t addr = 8; addr < 120; ++addr) {
      Wire.beginTransmission(addr);
      if (Wire.endTransmission() == 0) Serial.printf(" 0x%02X", addr);
    }
    Serial.println();
  }
  button();
  if(millis()-beepAt>=80)digitalWrite(D5,LOW);
  samplePulse();serviceIMU();server.handleClient();
  static unsigned long lastDisplay=0;
  if(millis()-lastDisplay<250)return;
  lastDisplay=millis();
#if USE_BLE
  publishBluetooth();
#endif
  Serial.println(row());
  if(hasOled){
    oled.clearDisplay();oled.setCursor(0,0);oled.setTextColor(SSD1306_WHITE);
    oled.setTextSize(2);oled.println(names[state]);
    oled.printf("Reps %u\n",reps);oled.print("BPM  ");
    if(bpm)oled.println(bpm);else oled.println("--");
    oled.setTextSize(1);oled.printf("%lus  IMU:%s HR:%s\n",elapsed()/1000,hasImu?"OK":"ERR",hasPpg?"OK":"ERR");
    oled.printf("ML: %s %d%%",labelName(),(int)(lastConf*100));
    oled.display();
  }
}
